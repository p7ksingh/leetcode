import java.util.Scanner;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter size of array : ");
       int n = sc.nextInt();
        int[] arr = new int[n];
        int left=0;
        int right=n-1;
        for(int i =0; i<arr.length;i++){
            if(i%2!=0){
                arr[right]=sc.nextInt();
                right--;
            }else{
                arr[left]=sc.nextInt();
                left++;
            }
        }
        for(int i=0; i<arr.length;i++){
            System.out.print(arr[i]);
        }
}
}
