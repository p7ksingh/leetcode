class Main {
    public static void main(String[] args) {
        int[] arr = {1,3,7,9,11,12,45};
        int target=90;
        int size = arr.length-1;
        int start = 0;
        int end = size;
        int midle;
        while(start<=size){
            midle = (start+end)/2;
            if(target == arr[midle]){
                System.out.println(midle);
                break;
            }
            if(target > arr[midle]){
                start=midle+1;
            }
            if(target < arr[midle]){
                end= midle-1;
            }
            if(start> end){
                System.out.println("-1");
                break;
            }
        }
}}
